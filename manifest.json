{
  "manifest_version": 3,
  "name": "Ozon ROI Hunter",
  "version": "1.3",
  "action": { "default_popup": "popup.html" },
  "permissions": [
    "storage",
    "tabs",
    "alarms",
    "notifications"
  ],
  "background": { "service_worker": "background.js" },
  "host_permissions": [ "*://*.ozon.ru/*" ],
  "content_scripts": [
    {
      "matches": ["*://*.ozon.ru/*"],
      "js": ["content.js"]
    }
  ]
}